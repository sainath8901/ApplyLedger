{
  "manifest_version": 3,
  "name": "ApplyLedger - Internal Job Tracker",
  "version": "2.0.1",
  "description": "Local application tracking, profiles, status history and admin reporting.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms",
    "identity"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html",
  "optional_permissions": [
    "notifications"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "key": ""
}
